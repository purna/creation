rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{userId}/saves/{saveId} {
   allow read, write: if request.auth != null && request.auth.uid == userId
    && saveId == 'main'
    && (request.method == 'get' || request.method == 'list' || request.resource.data.keys().hasAll(['schemaVersion','updatedAt','revision','graphs','star']))
    && (request.method == 'get' || request.method == 'list' || request.resource.data.schemaVersion == 2);
  }
 }
}
